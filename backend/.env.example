# Postgres (used by the application, not by docker-compose - see infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://clipforge:clipforge@localhost:5436/clipforge

# Redis
REDIS_URL=redis://localhost:6382/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI providers
# docker-compose injects this file (../backend/.env) into the api/worker
# containers via `env_file:`; container-specific values in the compose
# `environment:` block still take precedence.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model used when AI_PROVIDER=gemini (gemini-flash-latest, gemini-3.5-flash, ...)
GEMINI_MODEL=gemini-flash-latest
# Comma-separated fallback chain of API keys: tried in order after GEMINI_API_KEY
# if it fails or its daily free-tier quota is exhausted (each key has its own quota).
GEMINI_API_KEYS=
# Daily quota limits shown in the AI usage bar (per key)
GEMINI_DAILY_TOKEN_LIMIT=200000
GEMINI_DAILY_REQUEST_LIMIT=20

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
STORAGE_SIGNING_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8000

# App
APP_ENV=development
LOG_LEVEL=INFO
